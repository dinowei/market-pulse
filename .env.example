# Application
APP_ENV=development
APP_NAME=Market Pulse
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Persistence and cache
DATABASE_URL=
REDIS_URL=

# Session
SESSION_SECRET=
SESSION_COOKIE_NAME=market_pulse_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false

# Market data and internal refresh
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=
INTERNAL_REFRESH_SECRET=
QUOTE_FRESH_TTL_SECONDS=
QUOTE_STALE_MAX_AGE_SECONDS=
MARKET_PULSE_ENVIRONMENT=local
MARKET_PULSE_API_VERSION=0.1.0
MARKET_PULSE_DATABASE_URL=postgresql://market_pulse:market_pulse_local_only@127.0.0.1:5432/market_pulse
MARKET_PULSE_REDIS_URL=redis://127.0.0.1:6379/0
MARKET_PULSE_DATABASE_TIMEOUT_SECONDS=2
MARKET_PULSE_CACHE_TIMEOUT_SECONDS=1
MARKET_PULSE_INTERNAL_REFRESH_SECRET=
MARKET_PULSE_REFRESH_MAX_ITEMS=20
MARKET_PULSE_REFRESH_ITEM_TIMEOUT_SECONDS=5
MARKET_PULSE_REFRESH_TOTAL_TIMEOUT_SECONDS=30

# Candidate providers (disabled and UNREVIEWED by default; never expose to web)
BRAPI_API_TOKEN=
HG_BRASIL_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
OPEN_EXCHANGE_RATES_APP_ID=
MASSIVE_API_KEY=
B3_DEVELOPERS_CLIENT_ID=
B3_DEVELOPERS_CLIENT_SECRET=
B3_DEVELOPERS_TOKEN_URL=

# Day 28: Global security, CORS origins and Rate limiting configuration
# Comma-separated or JSON array of CORS origins allowed by global CORS and CSRF middleware
MARKET_PULSE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Day 28: retention window, in days, for operational records only (quarantine, raw
# payloads and Web Vitals aggregates). The financial ledger and audit_logs are never
# purged. The purge routine runs in dry-run unless explicitly told otherwise.
MARKET_PULSE_RETENTION_DAYS=90

# Day 18: Authentication, opaque sessions and Rate limiting configuration
MARKET_PULSE_AUTH_COOKIE_NAME=market_pulse_session
MARKET_PULSE_AUTH_SESSION_TTL_SECONDS=604800
MARKET_PULSE_AUTH_COOKIE_SECURE=false
MARKET_PULSE_AUTH_COOKIE_SAMESITE=lax
MARKET_PULSE_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
MARKET_PULSE_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Day 29: self-service registration. Empty = open in local/test, CLOSED in
# production/staging. Set true only while creating the staging account, then false.
MARKET_PULSE_REGISTRATION_ENABLED=

# Day 24: dedicated local DEMO preparation, disabled by default.
# No fallback to MARKET_PULSE_DATABASE_URL. The DEMO lifecycle accepts only the
# dedicated local database after every safety barrier and internal confirmation.
# APP_ENV=development must agree with MARKET_PULSE_ENVIRONMENT=local.
MARKET_PULSE_DEMO_ENABLED=false
# Keep false except for an explicit local bootstrap/reset of market_pulse_demo.
MARKET_PULSE_DEMO_ALLOW_RECREATE=false
MARKET_PULSE_DEMO_DATABASE_URL=

# Optional remote targets for the pytest suite (read only by apps/api/tests/conftest.py,
# from the environment or from apps/api/.env). Leave empty to use the local containers.
# The suite TRUNCATEs users, portfolios, the ledger and editorial tables, so these must
# point to disposable, test-only resources — never production, never shared.
#
# Neon (branch "dev", direct connection without pooler, TLS required). The database name
# MUST be market_pulse_test; conftest refuses any other name. Format:
#   postgresql://<credenciais>@<host-direto-do-neon>/market_pulse_test?sslmode=require&channel_binding=require
#   where <credenciais> is user:password exactly as Neon provides them.
MARKET_PULSE_TEST_DATABASE_URL=
#
# Upstash (TLS required, single logical database: no /N suffix). Format:
#   rediss://<credenciais>@<host-do-upstash>:6379
#   where <credenciais> is default:token exactly as Upstash provides them.
MARKET_PULSE_TEST_REDIS_URL=
