{
  "name": "market-pulse",
  "version": "0.0.0",
  "private": true,
  "description": "Market Pulse financial dashboard monorepo",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "lint": "pnpm --recursive --if-present run lint",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
